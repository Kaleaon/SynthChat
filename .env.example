# =============================================================================
# Google Drive API Credentials
# =============================================================================
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Optional: Parent folder ID in Google Drive for agent memories
AGENT_MEMORY_FOLDER_ID=

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# OpenAI API key (REQUIRED for LLM responses)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom LLM endpoint (for compatible APIs)
# LLM_API_ENDPOINT=https://api.openai.com/v1
# LLM_MODEL=gpt-4

# =============================================================================
# Web Application Settings (for Flask backend)
# =============================================================================

# SECURITY WARNING: Generate a secure random key for production!
# Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_RANDOM_SECRET

# Database URL (default: SQLite for development)
DATABASE_URL=sqlite:///synthchat.db

# Server settings
HOST=0.0.0.0
PORT=5000

# SECURITY WARNING: Never enable debug mode in production!
FLASK_DEBUG=false

# CORS allowed origins (comma-separated)
# SECURITY WARNING: Use specific origins in production, never use * in production
CORS_ALLOWED_ORIGINS=http://localhost:3000
